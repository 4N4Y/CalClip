{
  "manifest_version": 3,
  "name": "CalClip",
  "version": "1.0.0",
  "description": "Turn webpage information into a pre-filled Google Calendar event.",
  "action": {
    "default_title": "CalClip",
    "default_popup": "src/popup.html"
  },
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },
  "permissions": ["activeTab", "scripting"],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
